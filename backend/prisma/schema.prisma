// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  COMPANY
  ADMIN
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}

enum HackathonStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  JUDGING
  COMPLETED
  CANCELLED
}

enum SubmissionStatus {
  PENDING
  RUNNING
  PASSED
  FAILED
  ERROR
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?   // null for OAuth-only users
  firstName     String?
  lastName      String?
  role          UserRole  @default(USER)
  avatarUrl     String?
  bio           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // OAuth
  googleId      String?   @unique
  githubId      String?   @unique

  // Relations
  organizations OrganizationMember[]
  jobs          Job[]
  applications  Application[]
  hackathons    HackathonParticipant[]
  notifications Notification[]
  refreshTokens RefreshToken[]
  files         File[]

  @@index([email])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  deviceInfo String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  website     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     OrganizationMember[]
  jobs        Job[]
  hackathons  Hackathon[]

  @@index([slug])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String       @default("MEMBER") // MEMBER, ADMIN, OWNER
  joinedAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

model Job {
  id             String            @id @default(cuid())
  title          String
  description    String
  location       String?
  remote         Boolean           @default(false)
  salaryMin      Int?
  salaryMax      Int?
  currency       String?           @default("USD")
  status         String            @default("OPEN") // OPEN, CLOSED, DRAFT
  organizationId String?
  postedById     String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  postedBy       User               @relation(fields: [postedById], references: [id])
  applications  Application[]
  tags           JobTag[]

  @@index([organizationId])
  @@index([postedById])
  @@index([status])
}

model JobTag {
  id    String @id @default(cuid())
  jobId String
  name  String

  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, name])
  @@index([name])
}

model Application {
  id        String            @id @default(cuid())
  jobId     String
  userId    String
  resumeUrl String?
  coverLetter String?
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId])
  @@index([jobId])
  @@index([status])
}

model Hackathon {
  id          String            @id @default(cuid())
  title       String
  description String
  startDate   DateTime
  endDate     DateTime
  status      HackathonStatus   @default(DRAFT)
  imageUrl    String?
  prizePool   String?
  rules       String?
  organizationId String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  organization Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  participants HackathonParticipant[]
  rounds       Round[]
  leaderboard  LeaderboardEntry[]

  @@index([status])
  @@index([organizationId])
  @@index([startDate, endDate])
}

model HackathonParticipant {
  id          String    @id @default(cuid())
  hackathonId String
  userId      String
  joinedAt    DateTime  @default(now())
  teamName    String?

  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@unique([hackathonId, userId])
  @@index([hackathonId])
  @@index([userId])
}

model Round {
  id          String    @id @default(cuid())
  hackathonId String
  number      Int
  title       String
  description String
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@unique([hackathonId, number])
  @@index([hackathonId])
}

model Submission {
  id          String           @id @default(cuid())
  roundId     String
  participantId String
  code        String?          // code submission
  fileUrl     String?          // file submission
  status      SubmissionStatus @default(PENDING)
  score       Float?
  feedback    String?
  executionTime Int?           // milliseconds
  memoryUsed  Int?             // bytes
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  round       Round            @relation(fields: [roundId], references: [id], onDelete: Cascade)
  participant  HackathonParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([roundId])
  @@index([participantId])
  @@index([status])
  @@index([score])
}

model LeaderboardEntry {
  id          String   @id @default(cuid())
  hackathonId String
  userId      String
  totalScore  Float    @default(0)
  rank        Int?
  updatedAt   DateTime @updatedAt

  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  @@unique([hackathonId, userId])
  @@index([hackathonId, totalScore])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   // INFO, SUCCESS, WARNING, ERROR
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

model File {
  id        String   @id @default(cuid())
  userId    String
  url       String
  type      String   // resume, logo, submission, etc.
  filename  String
  size      Int      // bytes
  mimeType  String?
  uploadedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

